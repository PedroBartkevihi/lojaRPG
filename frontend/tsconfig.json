{
  // TypeScript gradual (D6): o codigo continua em JavaScript, e o tsc confere
  // so os arquivos de "include", pelos tipos de src/types.d.ts e pelo JSDoc.
  // Para tipar mais um modulo, acrescente-o aqui e rode npm run typecheck.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/types.d.ts", "src/vite-env.d.ts", "src/js/money.js", "src/js/weight.js", "src/js/csv.js"]
}
