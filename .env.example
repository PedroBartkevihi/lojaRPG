# Segredos lidos pelo docker compose. Copie para .env (que o Git ignora) e
# preencha com valores aleatorios; a API recusa iniciar em producao com
# valores curtos ou de exemplo. Para gerar um valor:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
MASTER_REGISTRATION_KEY=
