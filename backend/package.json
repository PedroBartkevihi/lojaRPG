{
  "name": "lojarpg-backend",
  "version": "1.0.0",
  "description": "API Express para uma loja de D&D com autenticacao, itens, personagens, inventario e compras.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "pretest": "prisma generate",
    "pretest:coverage": "prisma generate",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:backup": "node scripts/backup.js dump",
    "db:restore-check": "node scripts/backup.js restore-check",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "^7.10.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "^3.22.1"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "supertest": "^7.2.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
