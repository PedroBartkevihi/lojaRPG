{
  "name": "lojarpg-backend",
  "version": "1.0.0",
  "description": "API Express para uma loja de D&D com autenticacao, itens, personagens, inventario e compras.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/database/initDb.js",
    "db:seed": "node src/database/seedDb.js",
    "db:reset": "node src/database/resetDb.js",
    "db:migrate:legacy": "node src/database/migrateLegacyDb.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "pretest": "prisma generate",
    "pretest:coverage": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.8"
  }
}
