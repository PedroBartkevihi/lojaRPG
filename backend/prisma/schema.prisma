generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int              @id @default(autoincrement())
  name           String
  email          String           @unique
  passwordHash   String           @map("password_hash")
  // Sobe a cada troca de senha: tokens emitidos antes dela deixam de valer.
  sessionVersion Int              @default(0) @map("session_version")
  createdAt      DateTime         @default(now()) @map("created_at")
  memberships    CampaignMember[]
  characters     Character[]
  createdItems   Item[]           @relation("ItemCreator")
  refreshTokens  RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  goldAuditLogs  GoldAuditLog[]   @relation("GoldAuditActor")
  stockMovements StockMovement[]  @relation("StockMovementActor")
  inventoryLogs  InventoryLog[]   @relation("InventoryLogActor")
  checkoutRequests CheckoutRequest[]
  transferRequests TransferRequest[]
  itemRequests   ItemRequest[]

  @@map("users")
}

// Uma mesa e uma campanha: tem um Mestre, os jogadores convidados e um
// catalogo proprio. Personagens, itens e o historico ficam presos a ela.
model Campaign {
  id         Int              @id @default(autoincrement())
  name       String
  inviteCode String           @unique @map("invite_code")
  isDemo     Boolean          @default(false) @map("is_demo")
  shops      Shop[]
  createdAt  DateTime         @default(now()) @map("created_at")
  sessions   CampaignSession[]
  members    CampaignMember[]
  characters Character[]
  categories Category[]
  rarities   Rarity[]
  items      Item[]
  checkoutRequests CheckoutRequest[]
  transferRequests TransferRequest[]
  itemRequests     ItemRequest[]
  discounts        PriceDiscount[]

  @@map("campaigns")
}

model CampaignMember {
  id         Int      @id @default(autoincrement())
  campaignId Int      @map("campaign_id")
  userId     Int      @map("user_id")
  role       String
  joinedAt   DateTime @default(now()) @map("joined_at")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId])
  @@map("campaign_members")
}

model Character {
  id            Int            @id @default(autoincrement())
  campaignId    Int            @map("campaign_id")
  userId        Int            @map("user_id")
  name          String
  className     String         @map("class")
  race          String
  level         Int            @default(1)
  // Forca do personagem; a capacidade de carga e forca x 15 libras.
  strength      Int            @default(10)
  gold          BigInt            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")
  campaign      Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory     Inventory[]
  inventoryLogs InventoryLog[]
  purchases     Purchase[]
  goldAuditLogs GoldAuditLog[]
  itemRequests  ItemRequest[]
  discounts     PriceDiscount[]

  @@index([campaignId])
  @@index([userId])
  @@map("characters")
}

model Category {
  id          Int      @id @default(autoincrement())
  campaignId  Int      @map("campaign_id")
  name        String
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items       Item[]
  discounts   PriceDiscount[]

  @@unique([campaignId, name])
  @@map("categories")
}

model Rarity {
  id          Int      @id @default(autoincrement())
  campaignId  Int      @map("campaign_id")
  name        String
  rank        Int      @default(1)
  description String   @default("")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items       Item[]

  @@unique([campaignId, name])
  @@map("rarities")
}

model Shop {
  id Int @id @default(autoincrement())
  campaignId Int @map("campaign_id")
  name String
  hours String @default("")
  isOpen Boolean @default(true) @map("is_open")
  isDefault Boolean @default(false) @map("is_default")
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items Item[]
  @@unique([campaignId, name])
  @@unique([id, campaignId])
  @@map("shops")
}

model Item {
  id             Int             @id @default(autoincrement())
  campaignId     Int             @map("campaign_id")
  shopId         Int             @map("shop_id")
  shop           Shop            @relation(fields: [shopId, campaignId], references: [id, campaignId], onDelete: Restrict)
  name           String
  categoryId     Int             @map("category_id")
  rarityId       Int             @map("rarity_id")
  description    String          @default("")
  price          BigInt
  // Quanto a loja paga ao comprar o item de um jogador. Vazio segue a regra
  // do D&D 5e (metade do preco); isSellable falso faz a loja recusar o item.
  sellPrice      BigInt?            @map("sell_price")
  isSellable     Boolean         @default(true) @map("is_sellable")
  stock          Int             @default(0)
  // Atributos opcionais do livro: peso em libras, dano (armas), classe de
  // armadura (armaduras e escudos) e se o item exige sintonizacao.
  weight         Decimal?        @db.Decimal(8, 2)
  damage         String          @default("")
  armorClass     String          @default("") @map("armor_class")
  requiresAttunement Boolean     @default(false) @map("requires_attunement")
  imageUrl       String          @default("") @map("image_url")
  createdBy      Int?            @map("created_by")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at")
  campaign       Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category       Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  rarity         Rarity          @relation(fields: [rarityId], references: [id], onDelete: Restrict)
  creator        User?           @relation("ItemCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  inventory      Inventory[]
  inventoryLogs  InventoryLog[]
  purchaseItems  PurchaseItem[]
  stockMovements StockMovement[]
  itemRequests   ItemRequest[]

  @@index([campaignId])
  @@index([shopId])
  @@index([categoryId])
  @@index([rarityId])
  @@index([name])
  @@map("items")
}

model Inventory {
  id          Int       @id @default(autoincrement())
  characterId Int       @map("character_id")
  itemId      Int       @map("item_id")
  quantity    Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([characterId, itemId])
  @@index([characterId])
  @@map("inventory")
}

// Tudo o que muda o inventario fora de uma compra: vendas a loja, itens
// usados e recompensas dadas pelo Mestre.
model InventoryLog {
  id          Int       @id @default(autoincrement())
  characterId Int       @map("character_id")
  itemId      Int       @map("item_id")
  actorUserId Int?      @map("actor_user_id")
  type        String
  quantity    Int
  unitPrice   BigInt       @default(0) @map("unit_price")
  reason      String    @default("")
  createdAt   DateTime  @default(now()) @map("created_at")
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor       User?     @relation("InventoryLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([characterId])
  @@index([itemId])
  @@map("inventory_logs")
  @@index([createdAt, id])
  sessionId Int? @map("session_id")
  session CampaignSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([sessionId])

}

model Purchase {
  id          Int            @id @default(autoincrement())
  characterId Int            @map("character_id")
  totalValue  BigInt            @map("total_value")
  purchasedAt DateTime       @default(now()) @map("purchased_at")
  character   Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  items       PurchaseItem[]
  itemRequest ItemRequest?

  @@index([characterId])
  @@map("purchases")
  @@index([purchasedAt, id])
  sessionId Int? @map("session_id")
  session CampaignSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([sessionId])

}

// A reserva e o resultado sao gravados na mesma transacao da compra.
model CheckoutRequest {
  userId      Int      @map("user_id")
  campaignId  Int      @map("campaign_id")
  key         String   @db.VarChar(36)
  requestHash String   @map("request_hash") @db.VarChar(64)
  response    Json?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([userId, campaignId, key])
  @@index([campaignId])
  @@map("checkout_requests")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int      @map("purchase_id")
  itemId     Int      @map("item_id")
  quantity   Int
  unitPrice  BigInt      @map("unit_price")
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@map("purchase_items")
}

model GoldAuditLog {
  id           Int       @id @default(autoincrement())
  actorUserId  Int       @map("actor_user_id")
  characterId  Int       @map("character_id")
  previousGold BigInt       @map("previous_gold")
  newGold      BigInt       @map("new_gold")
  delta        BigInt
  reason       String
  createdAt    DateTime  @default(now()) @map("created_at")
  actor        User      @relation("GoldAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([characterId])
  @@map("gold_audit_logs")
  @@index([createdAt, id])
  sessionId Int? @map("session_id")
  session CampaignSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([sessionId])

}

model RefreshToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  // Versao da sessao da conta quando o token foi emitido.
  sessionVersion Int  @default(0) @map("session_version")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Desconto na compra: um evento da mesa ("feira na cidade: 20% em pocoes",
// com ou sem categoria) ou o desconto de um personagem (uma boa rolagem de
// persuasao). Vale o maior desconto que se aplica, sem somar.
model PriceDiscount {
  id          Int        @id @default(autoincrement())
  campaignId  Int        @map("campaign_id")
  name        String
  percent     Int
  categoryId  Int?       @map("category_id")
  characterId Int?       @map("character_id")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category    Category?  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  character   Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@map("price_discounts")
}

// Encomenda de um item fora do catalogo: o jogador descreve o que quer e
// quanto paga no maximo; o Mestre aprova (cobrando ate esse valor e entregando
// o item) ou recusa. A aprovacao vira uma compra no historico.
model ItemRequest {
  id          Int        @id @default(autoincrement())
  campaignId  Int        @map("campaign_id")
  characterId Int        @map("character_id")
  requestedBy Int?       @map("requested_by")
  description String
  maxPrice    BigInt     @map("max_price")
  status      String     @default("PENDENTE")
  price       BigInt?
  itemId      Int?       @map("item_id")
  purchaseId  Int?       @unique @map("purchase_id")
  masterNote  String     @default("") @map("master_note")
  createdAt   DateTime   @default(now()) @map("created_at")
  decidedAt   DateTime?  @map("decided_at")
  campaign    Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  requester   User?      @relation(fields: [requestedBy], references: [id], onDelete: SetNull)
  item        Item?      @relation(fields: [itemId], references: [id], onDelete: SetNull)
  purchase    Purchase?  @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([campaignId, status])
  @@index([characterId])
  @@map("item_requests")
}

// Link de redefinicao de senha: so o hash do token fica no banco, como no
// refresh token. Vale 30 minutos e uma vez.
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model StockMovement {
  id            Int      @id @default(autoincrement())
  itemId        Int      @map("item_id")
  actorUserId   Int?     @map("actor_user_id")
  previousStock Int      @map("previous_stock")
  newStock      Int      @map("new_stock")
  delta         Int
  reason        String
  createdAt     DateTime @default(now()) @map("created_at")
  item          Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  actor         User?    @relation("StockMovementActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([itemId])
  @@index([actorUserId])
  @@map("stock_movements")
  @@index([createdAt, id])
  sessionId Int? @map("session_id")
  session CampaignSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([sessionId])

}

model TransferRequest {
  userId      Int      @map("user_id")
  campaignId  Int      @map("campaign_id")
  key         String   @db.VarChar(36)
  requestHash String   @map("request_hash") @db.VarChar(64)
  currencyVersion Int @default(2) @map("currency_version")
  response    Json?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@id([userId, campaignId, key])
  @@index([campaignId])
  @@map("transfer_requests")
}

model CampaignSession {
  id Int @id @default(autoincrement())
  campaignId Int @map("campaign_id")
  number Int
  startedAt DateTime @default(now()) @map("started_at")
  endedAt DateTime? @map("ended_at")
  notes String @default("")
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  inventoryLogs InventoryLog[]
  goldAuditLogs GoldAuditLog[]
  stockMovements StockMovement[]
  @@unique([campaignId, number])
  @@index([campaignId, startedAt, id])
  @@map("campaign_sessions")
}
