PORT=3001
NODE_ENV=development
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Banco do docker compose (docker compose up -d db na raiz do projeto). Use
# 127.0.0.1 e nao localhost: no Windows, localhost tenta IPv6 primeiro e cada
# conexao nova fica lenta.
DATABASE_URL=postgresql://lojarpg:lojarpg@127.0.0.1:5432/lojarpg
# Os testes usam este banco e apagam os dados dele a cada teste.
TEST_DATABASE_URL=postgresql://lojarpg:lojarpg@127.0.0.1:5432/lojarpg_test
MASTER_REGISTRATION_KEY=chave-dev-para-criar-mestre
